{
  "name": "sarkariprep-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Open Source Government Exam Preparation Platform (Next.js + NestJS + FastAPI + PostgreSQL + Redis)",
  "license": "AGPL-3.0-or-later",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "npm --workspace=@sarkariprep/api run prisma:generate",
    "db:migrate": "npm --workspace=@sarkariprep/api run prisma:migrate",
    "db:seed": "npm --workspace=@sarkariprep/api run prisma:seed",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d"
  },
  "devDependencies": {
    "turbo": "^2.1.2",
    "typescript": "^5.6.2",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}