# ============================================================================
# SarkariPrep - PRODUCTION REFERENCE
# Supabase (Postgres) + Render (API, Redis, parser) + Vercel (web)
#
# Do NOT commit a populated copy of this file.
# Set these values in the Render dashboard / Vercel project settings.
# ============================================================================

# --- Supabase Postgres ---
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use the SESSION pooler URL (port 5432), not the transaction pooler (6543),
# so Prisma migrations work correctly.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?schema=public&sslmode=require"

# --- Render Key Value / Upstash Redis ---
# Render Key Value: copy the Internal URL from the instance's Connect menu.
# Upstash: use the TLS URL, e.g. rediss://default:<PASSWORD>@<HOST>:6379
REDIS_URL="redis://red-xxxxxxxxxxxxxxxxxxxx:6379"

# --- NestJS API (Render) ---
# Render injects PORT automatically; the API prefers PORT over API_PORT.
API_PORT=10000
JWT_SECRET="<generate-with: openssl rand -base64 48>"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
PARSER_SERVICE_URL="https://sarkariprep-parser.onrender.com"
PARSER_TIMEOUT_MS="180000"
PARSER_STATUS_TIMEOUT_MS="15000"
MAX_UPLOAD_MB="25"

# --- FastAPI parser (Render Docker service) ---
LLM_PROVIDER="heuristic"
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.1:8b"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Optional ingestion AI providers ---
INGESTION_AI_PROVIDER="auto"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct:free"
INGESTION_SCHEDULER_ENABLED="false"
INGESTION_SCHEDULER_INTERVAL_MS="300000"
INGESTION_FETCH_TIMEOUT_MS="25000"
INGESTION_AI_TIMEOUT_MS="30000"

# --- S3-compatible object storage (Cloudflare R2 recommended) ---
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_PAPERS="sarkariprep-papers"

# --- Next.js web (Vercel -> Project Settings -> Environment Variables) ---
NEXT_PUBLIC_API_URL="https://sarkariprep-api.onrender.com/api/v1"
NEXT_PUBLIC_WS_URL="wss://sarkariprep-api.onrender.com"
NEXT_PUBLIC_APP_NAME="SarkariPrep"
