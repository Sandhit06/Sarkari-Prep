# ============================================================================
# SarkariPrep Full-Stack Environment Configuration (LOCAL DEVELOPMENT TEMPLATE)
# Copy this file to .env before running `docker compose up` or `scripts/setup.sh`.
# For Supabase + Render + Vercel deployment, use .env.production.example.
# ============================================================================

# --- PostgreSQL Primary Database ---
POSTGRES_USER=sarkariprep
POSTGRES_PASSWORD=sarkariprep_secret
POSTGRES_DB=sarkariprep
DATABASE_URL="postgresql://sarkariprep:sarkariprep_secret@localhost:5432/sarkariprep?schema=public"

# --- Redis (live test timers, leaderboard cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# --- S3-Compatible Object Storage (MinIO local / Cloudflare R2 production) ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
S3_BUCKET_PAPERS="sarkariprep-papers"

# --- NestJS Main Backend API ---
API_PORT=4000
JWT_SECRET="dev-only-jwt-secret-change-me-before-deploying-000000000000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
PARSER_SERVICE_URL="http://localhost:8000"
PARSER_TIMEOUT_MS="180000"
PARSER_STATUS_TIMEOUT_MS="15000"
MAX_UPLOAD_MB="25"

# --- Python FastAPI Upload-to-Mock-Test Parsing Microservice ---
# Supported LLM_PROVIDER values: heuristic | ollama | anthropic | openai
# heuristic needs no external model or API key.
LLM_PROVIDER="heuristic"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Ingestion Brain (optional free AI providers) ---
INGESTION_AI_PROVIDER="auto"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct:free"
INGESTION_SCHEDULER_ENABLED="false"
INGESTION_SCHEDULER_INTERVAL_MS="300000"
INGESTION_FETCH_TIMEOUT_MS="25000"
INGESTION_AI_TIMEOUT_MS="30000"

# --- Next.js 14 Web Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"
NEXT_PUBLIC_APP_NAME="SarkariPrep"
